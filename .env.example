# =============================================================================
# BIMBA — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://bimba:bimba_password@postgres:5432/bimba

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant (Vector DB) ---
QDRANT_URL=http://qdrant:6333

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=bimba-files
MINIO_SECURE=false

# --- AI / LLM ---
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional: OpenAI Whisper API as fallback for transcription
OPENAI_API_KEY=sk-...

# --- Security ---
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=2048

# --- Processing Settings ---
# Duration of each audio chunk in seconds (default 5 minutes)
CHUNK_DURATION_SECONDS=300
# Overlap between consecutive chunks in seconds
CHUNK_OVERLAP_SECONDS=10
# Whisper model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v2
# Force transcription language (leave empty for auto-detection)
WHISPER_LANGUAGE=
# Slide change detection threshold (perceptual hash difference)
SLIDE_CHANGE_THRESHOLD=10
# Semantic link minimum similarity score (0.0 - 1.0)
SEMANTIC_SIMILARITY_THRESHOLD=0.3

# --- Celery Workers ---
WORKER_CONCURRENCY=4
# Separate queue names
CELERY_QUEUE_HIGH=high_priority
CELERY_QUEUE_TRANSCRIPTION=transcription
CELERY_QUEUE_OCR=ocr
CELERY_QUEUE_LLM=llm
CELERY_QUEUE_EXPORT=export

# --- Flower (Celery Monitor) ---
FLOWER_USER=admin
FLOWER_PASSWORD=flowerpassword

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false
